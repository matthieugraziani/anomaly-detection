FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml .
COPY src/ src/
COPY models/ models/

RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir uvicorn[standard]

EXPOSE 8000

CMD ["uvicorn", "anomaly_detection.serving.api:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
